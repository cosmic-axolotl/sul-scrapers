# ID da planilha do Google Sheets (o trecho da URL entre /d/ e /edit).
# Veja a seção 2 do README para o passo a passo de como criar isso.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Nome da aba dentro da planilha onde os dados serão gravados.
# Opcional — se não definir, usa "Coleta" como padrão.
GOOGLE_SHEETS_WORKSHEET_NAME=Coletasada